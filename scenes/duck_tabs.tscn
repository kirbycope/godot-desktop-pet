text = "Start"

[node name="Skip" type="Button" parent="Pomodoro/Buttons"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "End this focus or break now and go on to the next."
disabled = true
text = "Skip"

[node name="Stop" type="Button" parent="Pomodoro/Buttons"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Stop the timer; the duck stops being a tomato."
