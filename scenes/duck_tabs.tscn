[node name="Tabs" type="TabContainer"]
current_tab = 0
script = ExtResource("1")

[node name="Chat" type="VBoxContainer" parent="."]
layout_mode = 2
metadata/_tab_index = 0

[node name="Top" type="HBoxContainer" parent="Chat"]
layout_mode = 2

[node name="New" type="Button" parent="Chat/Top"]
layout_mode = 2
tooltip_text = "Start a new conversation; this one is kept under Past."
text = "New"

[node name="Past" type="Button" parent="Chat/Top"]
layout_mode = 2
tooltip_text = "Past conversations: pick one to take it up again."
toggle_mode = true
text = "Past"

[node name="Conversation" type="ScrollContainer" parent="Chat"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Messages" type="VBoxContainer" parent="Chat/Conversation"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Messages"

[node name="PastList" type="ItemList" parent="Chat"]
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="Entry" type="HBoxContainer" parent="Chat"]
layout_mode = 2

[node name="Status" type="PanelContainer" parent="Chat/Entry"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_status")

[node name="Row" type="HBoxContainer" parent="Chat/Entry/Status"]
layout_mode = 2

[node name="Label" type="Label" parent="Chat/Entry/Status/Row"]
layout_mode = 2
size_flags_horizontal = 3
clip_text = true
text_overrun_behavior = 3
theme_override_colors/font_color = Color(0.6, 0.05, 0.05, 1)
text = "Listening: talk, then pause"

[node name="Level" type="ProgressBar" parent="Chat/Entry/Status/Row"]
custom_minimum_size = Vector2(36, 10)
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/background = SubResource("StyleBoxFlat_level_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_level_fill")
min_value = -60.0
max_value = -10.0
value = -60.0
show_percentage = false

[node name="Input" type="LineEdit" parent="Chat/Entry"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Talk to me, then Enter"

[node name="Mic" type="Button" parent="Chat/Entry"]
custom_minimum_size = Vector2(34, 0)
layout_mode = 2
tooltip_text = "Talk to the duck. It sends when you pause, and listens again after it answers. Click again to stop."
toggle_mode = true
icon = ExtResource("2")
icon_alignment = 1
expand_icon = true

[node name="Dot" type="Panel" parent="Chat/Entry/Mic"]
visible = false
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -12.0
offset_top = 2.0
offset_right = -2.0
offset_bottom = 12.0
grow_horizontal = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_dot")

[node name="Send" type="Button" parent="Chat/Entry"]
layout_mode = 2
disabled = true
text = "Send"

[node name="Pomodoro" type="VBoxContainer" parent="."]
visible = false
layout_mode = 2
metadata/_tab_index = 1

[node name="Phase" type="Label" parent="Pomodoro"]
layout_mode = 2
