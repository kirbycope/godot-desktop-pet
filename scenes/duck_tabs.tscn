text = "25:00"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Bar" type="ProgressBar" parent="Pomodoro"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_pomodoro_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_pomodoro_fill")
max_value = 1.0
show_percentage = false

[node name="Buttons" type="HBoxContainer" parent="Pomodoro"]
layout_mode = 2

[node name="Start" type="Button" parent="Pomodoro/Buttons"]
layout_mode = 2
size_flags_horizontal = 3
