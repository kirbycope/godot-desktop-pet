[node name="Setup" type="OptionButton" parent="Stats"]
visible = false
layout_mode = 2
tooltip_text = "Which engine and model the duck thinks with on this phone. Changing it deletes the model in use and downloads the new one."

[node name="Bench" type="Button" parent="Stats"]
visible = false
layout_mode = 2
tooltip_text = "Tries every engine and model on this phone in turn, deleting each before the next, and records how fast each downloads, starts and answers."
text = "Run the benchmark"

